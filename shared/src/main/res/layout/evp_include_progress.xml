<?xml version="1.0" encoding="utf-8"?>
<!--
    Vendored from afollestad/easy-video-player 0.3.0. Upstream used
    me.zhanghai.android.materialprogressbar.MaterialProgressBar here; swapped for the
    framework's own indeterminate spinner so the vendored code needs no extra
    support-library-era dependency.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ProgressBar
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true" />

</FrameLayout>
